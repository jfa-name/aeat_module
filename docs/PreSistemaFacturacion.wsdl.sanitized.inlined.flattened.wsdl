				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="N1">
				<xs:annotation>
					<xs:documentation xml:lang="es">OPERACIÓN NO SUJETA ARTÍCULO 7, 14, OTROS.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="N2">
				<xs:annotation>
					<xs:documentation xml:lang="es">OPERACIÓN NO SUJETA POR REGLAS DE LOCALIZACIÓN</xs:documentation>
				</xs:annotation>
