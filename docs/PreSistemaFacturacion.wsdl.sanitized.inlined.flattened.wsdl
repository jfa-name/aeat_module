			<xs:enumeration value="SinDatos"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ErrorDetalleType">
		<xs:restriction base="integer"/>
	</xs:simpleType>
	<xs:simpleType name="EstadoRegistroType">
		<xs:restriction base="string">
			<xs:enumeration value="Correcto">
				<xs:annotation>
					<xs:documentation xml:lang="es">El registro se almacenado sin errores</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AceptadoConErrores">
				<xs:annotation>
					<xs:documentation xml:lang="es">El registro se almacenado tiene algunos errores. Ver detalle del error</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Anulado">
				<xs:annotation>
					<xs:documentation xml:lang="es">El registro almacenado ha sido anulado</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
