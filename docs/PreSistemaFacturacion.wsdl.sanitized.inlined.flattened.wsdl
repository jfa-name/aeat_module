	<!-- Estado del registro duplicado almacenado en el sistema -->
	<xs:simpleType name="EstadoRegistroSFType">
		<xs:restriction base="string">
			<xs:enumeration value="Correcta">
				<xs:annotation>
					<xs:documentation xml:lang="es">El registro se ha almacenado sin errores</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AceptadaConErrores">
				<xs:annotation>
					<xs:documentation xml:lang="es">El registro que se ha almacenado tiene algunos errores. Ver detalle del error</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Anulada">
				<xs:annotation>
					<xs:documentation xml:lang="es">El registro almacenado ha sido anulado</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
