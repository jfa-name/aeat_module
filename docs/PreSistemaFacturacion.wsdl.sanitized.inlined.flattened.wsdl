			</xs:enumeration>
			<xs:enumeration value="D">
				<xs:annotation>
					<xs:documentation xml:lang="es">Destinatario</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="T">
