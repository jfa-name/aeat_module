					<xs:documentation xml:lang="es"> Tercero que expida la factura y/o genera el registro de alta. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Destinatarios" minOccurs="0">
				<xs:complexType>
					<xs:annotation>
						<xs:documentation xml:lang="es">Contraparte de la operación. Cliente</xs:documentation>
					</xs:annotation>
					<xs:sequence>
						<xs:element name="IDDestinatario" type="sf:PersonaFisicaJuridicaType" maxOccurs="1000"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="Cupon" type="sf:CuponType" minOccurs="0"/>
			<xs:element name="Desglose" type="sf:DesgloseType" minOccurs="0"/>
			<xs:element name="CuotaTotal" type="sf:ImporteSgn12.2Type" minOccurs="0"/>
			<xs:element name="ImporteTotal" type="sf:ImporteSgn12.2Type" minOccurs="0"/>
