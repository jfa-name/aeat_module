	<xs:simpleType name="IndicadorPaginacionType">
		<xs:restriction base="string">
			<xs:enumeration value="S"/>
			<xs:enumeration value="N"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ResultadoConsultaType">
		<xs:restriction base="string">
