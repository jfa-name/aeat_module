					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DescripcionErrorRegistro" type="sf:TextMax500Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="es"> 
						Descripción detallada del error de registro, en su caso.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
