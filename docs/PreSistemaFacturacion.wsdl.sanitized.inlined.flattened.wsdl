	<xs:complexType name="RegistroDuplicadoType">
		<xs:sequence>
			<xs:element name="IdPeticionRegistroDuplicado" type="sf:TextMax20Type">
				<xs:annotation>
					<xs:documentation xml:lang="es"> 
						IdPeticion asociado a la factura registrada previamente en el sistema. Solo se suministra si la factura enviada es rechazada por estar duplicada
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EstadoRegistroDuplicado" type="sf:EstadoRegistroSFType">
				<xs:annotation>
					<xs:documentation xml:lang="es"> 
						Estado del registro duplicado almacenado en el sistema. Los estados posibles son: Correcta, AceptadaConErrores y Anulada. Solo se suministra si la factura enviada es rechazada por estar duplicada
											</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CodigoErrorRegistro" type="sf:ErrorDetalleType" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="es"> 
						Código del error de registro duplicado almacenado en el sistema, en su caso.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DescripcionErrorRegistro" type="sf:TextMax500Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="es"> 
						Descripción detallada del error de registro duplicado almacenado en el sistema, en su caso.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
