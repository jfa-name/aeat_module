	<xs:simpleType name="Tipo10Type">
		<xs:restriction base="string">
			<xs:pattern value="\d{0,10}"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- Importe de 15 dígitos (12+2) "." como separador decimal -->
	<xs:simpleType name="ImporteSgn12.2Type">
		<xs:restriction base="string">
			<xs:pattern value="(\+|-)?\d{1,12}(\.\d{0,2})?"/>
		</xs:restriction>
	</xs:simpleType>
