			<xs:enumeration value="S1">
				<xs:annotation>
					<xs:documentation xml:lang="es"> OPERACIÓN SUJETA Y NO EXENTA - SIN INVERSIÓN DEL SUJETO PASIVO.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
