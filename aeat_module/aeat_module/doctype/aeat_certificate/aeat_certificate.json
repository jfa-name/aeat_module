{
  "doctype": "DocType",
  "name": "AEAT Certificate",
  "module": "AEAT Module",
  "custom": 1,
  "istable": 0,
  "fields": [
    {
      "fieldname": "company",
      "label": "Company",
      "fieldtype": "Link",
      "options": "Company",
      "reqd": 1
    },
    {
      "fieldname": "certificate_name",
      "label": "Certificate Name / Alias",
      "fieldtype": "Data"
    },
    {
      "fieldname": "cert_path",
      "label": "Certificate Path",
      "fieldtype": "Data",
      "description": "Filesystem path to cert.pem or identifier"
    },
    {
      "fieldname": "key_path",
      "label": "Private Key Path",
      "fieldtype": "Data"
    },
    {
      "fieldname": "key_format",
      "label": "Key Format",
      "fieldtype": "Select",
      "options": "PEM\nPKCS12",
      "default": "PEM"
    },
    {
      "fieldname": "key_password",
      "label": "Key Password / Passphrase",
      "fieldtype": "Password"
    },
    {
      "fieldname": "active",
      "label": "Active",
      "fieldtype": "Check",
      "default": 1
    },
    {
      "fieldname": "notes",
      "label": "Notes",
      "fieldtype": "Text"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}
